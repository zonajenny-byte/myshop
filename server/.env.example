# 後台登入密碼，自己改一組，不要用範例值
ADMIN_PASSWORD=change-me
# 簽 token 用的密鑰，跟密碼分開一組，越長越好
TOKEN_SECRET=change-me-too
# 客戶登入用的簽章密鑰，要跟上面 TOKEN_SECRET 不一樣，兩個信任範圍分開
CUSTOMER_TOKEN_SECRET=change-me-yet-again
PORT=3000
# 前端網域，逗號分隔多個
CORS_ORIGIN=http://localhost:5173

# ---- 綠界科技 ECPay ----
# 三個都拿到之前留空，/api/checkout 會回「金流尚未設定」而不是壞掉。
# 一到手直接填這裡，不用改任何程式碼。
#
# 想先測試流程，可以填綠界官方公開的測試特店帳號（每份官方教學都在用這組）：
#   ECPAY_MERCHANT_ID=2000132
#   ECPAY_HASH_KEY=5294y06JbISpM5x9
#   ECPAY_HASH_IV=v77hoKGq4kWxNNIS
# 這組只能在 ECPAY_SANDBOX=true（測試環境）用，不會是真的錢，
# 正式營業前一定要換成你自己申請到的正式金鑰。
# 官方也提供專屬沙盒帳號可以在 vendor.ecpay.com.tw 後台的
# 「系統開發 → 系統介接測試」申請，效果一樣。
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
# true=測試環境（payment-stage.ecpay.com.tw）／false=正式環境（payment.ecpay.com.tw）
# 拿到正式金鑰、確認金流真的走得通之前，不要改成 false
ECPAY_SANDBOX=true

# 部署後端本身的網址，綠界的付款通知要打回這裡
# 本機開發免填，用預設的 http://localhost:PORT 就好
# 本機測試 webhook 收得到的話要用 cloudflared 之類的工具開一個對外網址，
# 不能用 http://localhost，綠界的伺服器連不到你的電腦
BACKEND_URL=
# 前端網址，付款完瀏覽器導回這裡
FRONTEND_URL=http://localhost:5173

# ---- Anthropic API（AI 工具判讀用） ----
# 去 console.anthropic.com 申請，沒設定的話 /v1/tool/run 會回錯誤訊息而不是壞掉
ANTHROPIC_API_KEY=
# 選填，預設用 Sonnet。想省成本可以改成 Haiku 系列（claude-haiku-4-5-20251001），
# 但食安/保養品判讀碰得到過敏原這類讀錯有實際後果的內容，精準度優先。
ANTHROPIC_MODEL=claude-sonnet-5

# ---- 寄信服務 Resend（賣數位商品前必須設定）----
# 去 resend.com 註冊拿 API key。免費方案每月 3000 封、但每天上限 100 封，
# 一般訂單量夠用；如果做活動一天可能超過 100 筆，要先升級方案。
RESEND_API_KEY=
# 寄件人。網域要先在 Resend 後台驗證過才能用自己的網域。
# 還沒驗證前可以用預設的 onboarding@resend.dev，但那個只能寄給你自己註冊的信箱，
# 客人收不到——所以正式上線前一定要驗證自己的網域。
RESEND_FROM=AuraPlayground <noreply@auraplayground.com>

# ---- LINE 新訂單通知（選用，沒設定不影響其他功能） ----
# 去 developers.line.biz 建一個 Messaging API 頻道（免費），拿 Channel Access Token
LINE_CHANNEL_ACCESS_TOKEN=
# 選填。有填就推播給特定一人/群組（userId 或 groupId）；
# 沒填就用 broadcast 送給這個官方帳號的所有好友——
# 一人商店只要加自己好友，效果一樣，不用另外去查 userId
LINE_TARGET_ID=
# 要用「打字回覆指令」（例如打「匯總」查過去2小時訂單）才需要這個，
# 同樣在 LINE Developers Console 的頻道設定裡拿，跟上面的 access token 是不同東西
LINE_CHANNEL_SECRET=
